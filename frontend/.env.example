# Lapa Casa Hostel - Frontend
# Copiar a .env.local y completar con los valores reales.
# Auditoría 17 secciones, sección 16: lista generada a partir de cada
# process.env.NEXT_PUBLIC_* que el código del frontend efectivamente lee
# (grep -rhoE "process\.env\.NEXT_PUBLIC_[A-Z_]+" src). El backend tiene su
# propio .env.example -- no compartido, son procesos/deploys separados
# (Render para el frontend, Fly.io para el backend).

# URL pública de la API del backend (hoy en Fly.io, no Render).
NEXT_PUBLIC_API_URL=https://api.lapacasario.com/api/v1

# URL pública del sitio (usada para canonical/hreflang/sitemap/robots).
NEXT_PUBLIC_SITE_URL=https://lapacasario.com

# Clave pública (publishable) de Stripe -- nunca la secret key acá, esta sí
# viaja al navegador.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx

# Número de WhatsApp Business para el botón de contacto directo (formato
# internacional sin "+", ej. 5521999999999).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Analítica -- opcionales. Sin estas dos, GA4/Facebook Pixel simplemente no
# se cargan (ver components/analytics/analytics-provider.tsx), y de
# cualquier forma quedan gateados por el banner de cookies hasta que el
# huésped acepte.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
