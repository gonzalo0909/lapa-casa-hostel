{
  "name": "lapa-casa-hostel-frontend",
  "version": "1.0.0",
  "description": "Channel Manager frontend for Lapa Casa Hostel - Group booking system",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "@stripe/stripe-js": "^4.1.0",
    "@stripe/react-stripe-js": "^2.7.3",
    "qrcode.react": "^3.1.0",
    "zustand": "^4.5.4",
    "next-intl": "^3.17.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.4.0",
    "class-variance-authority": "^0.7.0",
    "lucide-react": "^0.417.0",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@next/bundle-analyzer": "^14.2.5",
    "@svgr/webpack": "^8.1.0",
    "tailwindcss": "^3.4.7",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.13",
    "tailwindcss-animate": "^1.0.7",
    "postcss": "^8.4.40",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/user-event": "^14.5.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "ts-jest": "^29.4.12",
    "identity-obj-proxy": "^3.0.0",
    "@playwright/test": "^1.45.3",
    "@types/jest": "^29.5.12",
    "msw": "^2.3.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "channel-manager",
    "hostel",
    "booking-engine",
    "group-bookings",
    "stripe",
    "mercado-pago",
    "pix",
    "nextjs",
    "react",
    "typescript"
  ],
  "author": {
    "name": "Lapa Casa Hostel Tech Team",
    "email": "lapalandiarj@gmail.com"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/lapacasahostel/lapa-casa-hostel"
  }
}
